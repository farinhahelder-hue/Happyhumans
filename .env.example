# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=happyhumans.fr

# Calendly
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min

# Email notifications for new contact messages (optional).
# Uses the Resend API (https://resend.com). Leave unset to disable — messages
# are still saved and visible in the admin "Messages" tab either way.
# FROM must be an address on a domain verified in your Resend account.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=monica.schneider@hotmail.fr
CONTACT_NOTIFICATION_FROM=contact@happyhumans.fr
